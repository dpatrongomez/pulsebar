{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsebar.app/schemas/login.schema.json",
  "title": "pulsebar config login --json",
  "type": "object",
  "properties": {
    "login": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "enabled",
            "disabled",
            "requires_approval",
            "unbundled",
            "unsupported"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "status",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "login"
  ],
  "additionalProperties": false
}
